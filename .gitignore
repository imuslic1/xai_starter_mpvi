# Python virtual environments
.venv/
venv/
env/
ENV/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/

# Build and packaging
build/
dist/
*.egg-info/
.eggs/

# Model checkpoints and weights
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.h5

# Generated results, plots, and Grad-CAM explanations
/outputs/
/results/
/checkpoints/
/runs/
/logs/

# Local dataset and model caches
/data/
/datasets/
/models/
/cache/
/.cache/
huggingface/
.huggingface/

# Jupyter temporary files
.ipynb_checkpoints/

# Local environment files
.env
.env.*
!.env.example

# IDE and editor local settings
.vscode/
.idea/
*.code-workspace

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.log
*.tmp
*.bak
*.swp
*~
